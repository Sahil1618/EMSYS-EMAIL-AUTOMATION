# Copy this file to .streamlit/secrets.toml and fill in your company SMTP details.
# NEVER commit the real secrets.toml to git.

[smtp]
host = "smtp.yourcompany.com"
port = 587                      # 465 for SSL, 587 for STARTTLS
username = "your_login"
password = "your_password"
from_email = "scheduling@yourcompany.com"
use_tls = true
